{
  "name": "file-transfer-server",
  "version": "1.0.0",
  "description": "Server to receive files and links from iOS Shortcuts",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "start:gui": "electron .",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.filetransfer.app",
    "asarUnpack": [
      "**/*.ps1"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    }
  },
  "dependencies": {
    "clipboardy": "^5.3.2",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
